{
  "datasets": [
    {
      "name": "listings_per_snapshot",
      "displayName": "Listing count per snapshot",
      "queryLines": [
        "SELECT timestamp AS snapshot_time,\n",
        "  date_format(timestamp, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time_text,\n",
        "  sum(listing_count) AS single_gpu_listings,\n",
        "  count(DISTINCT gpu_name) AS models\n",
        "FROM solgpu.gold.gpu_price_trends\n",
        "WHERE region = 'all'\n",
        "GROUP BY timestamp\n",
        "ORDER BY timestamp\n"
      ]
    },
    {
      "name": "price_spread",
      "displayName": "Price spread per GPU model, latest snapshot",
      "queryLines": [
        "SELECT gpu_name, listing_count, lowest_price, median_price, p90_price, median_reliability,\n",
        "  date_format(updated_at, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time\n",
        "FROM solgpu.gold.gpu_market_summary\n",
        "WHERE listing_count >= 3\n",
        "ORDER BY listing_count DESC\n"
      ]
    },
    {
      "name": "rtx4090_trend",
      "displayName": "RTX 4090 median price with p10 and p90, all regions",
      "queryLines": [
        "SELECT timestamp, date_format(timestamp, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time, listing_count, series, price\n",
        "FROM solgpu.gold.gpu_price_trends\n",
        "LATERAL VIEW stack(3, 'p10_price', p10_price, 'median_price', median_price, 'p90_price', p90_price) s AS series, price\n",
        "WHERE gpu_name = 'RTX 4090' AND region = 'all'\n",
        "ORDER BY timestamp, series\n"
      ]
    },
    {
      "name": "rtx4090_regions",
      "displayName": "RTX 4090 median price per region, latest snapshot",
      "queryLines": [
        "SELECT region, median_price, listing_count, date_format(timestamp, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time\n",
        "FROM solgpu.gold.gpu_price_trends\n",
        "WHERE gpu_name = 'RTX 4090' AND region <> 'all'\n",
        "  AND snapshot_id = (SELECT max(snapshot_id) FROM solgpu.gold.gpu_price_trends)\n",
        "ORDER BY median_price\n"
      ]
    },
    {
      "name": "latest_snapshot",
      "displayName": "Latest gold snapshot",
      "queryLines": [
        "SELECT date_format(max(updated_at), 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS latest_snapshot\n",
        "FROM solgpu.gold.gpu_market_summary\n"
      ]
    },
    {
      "name": "lineage_latest",
      "displayName": "Row count per stage, latest snapshot",
      "queryLines": [
        "WITH latest AS (SELECT max(snapshot_id) AS sid, date_format(max(captured_at), 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time FROM solgpu.silver.offers),\n",
        "counts AS (\n",
        "  SELECT 'bronze.vast_offers_raw' AS stage, count(*) AS rows, 1 AS stage_order FROM solgpu.bronze.vast_offers_raw, latest WHERE snapshot_id = latest.sid\n",
        "  UNION ALL SELECT 'silver.offers', count(*), 2 FROM solgpu.silver.offers, latest WHERE snapshot_id = latest.sid\n",
        "  UNION ALL SELECT 'silver.offers_rejected', count(*), 3 FROM solgpu.silver.offers_rejected, latest WHERE snapshot_id = latest.sid\n",
        "  UNION ALL SELECT 'gold.gpu_market_summary (models)', count(*), 4 FROM solgpu.gold.gpu_market_summary, latest WHERE snapshot_id = latest.sid\n",
        "  UNION ALL SELECT 'gold.gpu_price_trends (rows for this snapshot)', count(*), 5 FROM solgpu.gold.gpu_price_trends, latest WHERE snapshot_id = latest.sid\n",
        "  UNION ALL SELECT 'gold.offer_market_position (single-GPU offers)', count(*), 6 FROM solgpu.gold.offer_market_position, latest WHERE snapshot_id = latest.sid\n",
        ")\n",
        "SELECT counts.stage, counts.rows, counts.stage_order, latest.snapshot_time\n",
        "FROM counts CROSS JOIN latest\n",
        "ORDER BY counts.stage_order\n"
      ]
    },
    {
      "name": "data_quality",
      "displayName": "Data quality per snapshot (silver.data_quality)",
      "queryLines": [
        "SELECT date_format(captured_at, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time, snapshot_id, raw_rows, silver_rows, rejected_total,\n",
        "  rejected_missing_gpu_name, rejected_nonpositive_price, rejected_reliability_out_of_range, duplicates_removed,\n",
        "  distinct_gpu_names_raw, distinct_gpu_names_canonical, unmapped_gpu_names, unmapped_gpu_rows, unmapped_regions\n",
        "FROM solgpu.silver.data_quality\n",
        "ORDER BY captured_at DESC\n"
      ]
    },
    {
      "name": "rejected_by_reason",
      "displayName": "Rejected rows by reason, all snapshots",
      "queryLines": [
        "SELECT reject_reason, count(*) AS rows\n",
        "FROM solgpu.silver.offers_rejected\n",
        "GROUP BY 1\n",
        "ORDER BY 2 DESC\n"
      ]
    },
    {
      "name": "dq_totals",
      "displayName": "Data quality totals, all snapshots",
      "queryLines": [
        "SELECT sum(duplicates_removed) AS duplicates_removed, sum(rejected_total) AS rejected_total, count(*) AS snapshots\n",
        "FROM solgpu.silver.data_quality\n"
      ]
    },
    {
      "name": "unmapped_latest",
      "displayName": "Unmapped GPU names and regions, latest snapshot",
      "queryLines": [
        "SELECT 'gpu' AS kind, gpu_name_raw AS raw_value, count(*) AS rows\n",
        "FROM solgpu.silver.offers\n",
        "WHERE NOT gpu_name_mapped AND snapshot_id = (SELECT max(snapshot_id) FROM solgpu.silver.offers)\n",
        "GROUP BY 1, 2\n",
        "UNION ALL\n",
        "SELECT 'region', region_raw, count(*)\n",
        "FROM solgpu.silver.offers\n",
        "WHERE NOT region_mapped AND snapshot_id = (SELECT max(snapshot_id) FROM solgpu.silver.offers)\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1, 3 DESC\n"
      ]
    },
    {
      "name": "names_before_after",
      "displayName": "GPU names before and after the name map, latest snapshot",
      "queryLines": [
        "SELECT distinct_gpu_names_raw, distinct_gpu_names_canonical, unmapped_gpu_names, date_format(captured_at, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS snapshot_time\n",
        "FROM solgpu.silver.data_quality\n",
        "ORDER BY captured_at DESC\n",
        "LIMIT 1\n"
      ]
    },
    {
      "name": "contract_checks_latest",
      "displayName": "Gold contract checks, latest run",
      "queryLines": [
        "SELECT table_name, rule, failing_rows, passed, date_format(checked_at, 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS checked_at\n",
        "FROM solgpu.gold.contract_checks\n",
        "WHERE checked_at = (SELECT max(checked_at) FROM solgpu.gold.contract_checks)\n",
        "ORDER BY table_name, rule\n"
      ]
    },
    {
      "name": "contract_checks_summary",
      "displayName": "Gold contract checks passed, latest run",
      "queryLines": [
        "SELECT sum(CASE WHEN passed THEN 1 ELSE 0 END) AS rules_passed, count(*) AS rules_total, date_format(max(checked_at), 'yyyy-MM-dd HH:mm:ss') || ' UTC' AS checked_at\n",
        "FROM solgpu.gold.contract_checks\n",
        "WHERE checked_at = (SELECT max(checked_at) FROM solgpu.gold.contract_checks)\n"
      ]
    }
  ],
