{
  "name": "solgpu-pipeline",
  "description": "Runs bronze ingest, name maps, silver, data quality, and the three gold tables, then the gold contract checks, in order every 10 minutes.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 1500,
  "schedule": {
    "quartz_cron_expression": "0 5/10 * * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "tags": {
    "owner": "P4",
    "project": "solgpu"
  },
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "notebook_task": {
        "notebook_path": "/Shared/solgpu/01_bronze_ingest",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "name_maps",
      "depends_on": [{ "task_key": "bronze_ingest" }],
      "sql_task": {
        "file": { "path": "/Shared/solgpu/sql/20_name_maps.sql", "source": "WORKSPACE" },
        "warehouse_id": "3ed885676f1ef2ab"
      }
    },
    {
      "task_key": "silver_offers",
      "depends_on": [{ "task_key": "name_maps" }],
      "notebook_task": {
        "notebook_path": "/Shared/solgpu/02_silver_offers",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "data_quality",
      "depends_on": [{ "task_key": "silver_offers" }],
      "notebook_task": {
        "notebook_path": "/Shared/solgpu/03_data_quality",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "gold_market_summary",
      "depends_on": [{ "task_key": "data_quality" }],
      "sql_task": {
        "file": { "path": "/Shared/solgpu/sql/30_gold_market_summary.sql", "source": "WORKSPACE" },
        "warehouse_id": "3ed885676f1ef2ab"
      }
    },
    {
      "task_key": "gold_price_trends",
      "depends_on": [{ "task_key": "gold_market_summary" }],
      "sql_task": {
        "file": { "path": "/Shared/solgpu/sql/31_gold_price_trends.sql", "source": "WORKSPACE" },
        "warehouse_id": "3ed885676f1ef2ab"
      }
    },
    {
      "task_key": "gold_offer_market_position",
      "depends_on": [{ "task_key": "gold_price_trends" }],
      "sql_task": {
        "file": { "path": "/Shared/solgpu/sql/32_gold_offer_market_position.sql", "source": "WORKSPACE" },
        "warehouse_id": "3ed885676f1ef2ab"
      }
    },
    {
      "task_key": "gold_checks",
      "depends_on": [{ "task_key": "gold_offer_market_position" }],
      "sql_task": {
        "file": { "path": "/Shared/solgpu/sql/39_gold_checks.sql", "source": "WORKSPACE" },
        "warehouse_id": "3ed885676f1ef2ab"
      }
    }
  ]
}
