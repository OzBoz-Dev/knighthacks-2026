# Copy this file to .env.local. These values are public and reach the browser.
# Do not put a Vast.ai key, a Databricks token, or another secret here.

# The base URL of the solGPU Go API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The Solana devnet RPC endpoint. The app refuses a URL that names mainnet.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Set to 1 to load the synthetic development samples. This works only with `npm run dev`.
NEXT_PUBLIC_USE_DEV_FIXTURES=0
