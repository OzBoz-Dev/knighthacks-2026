# Copy this file to api/.env and fill in the values. Never commit api/.env.
PORT=8000
# Comma-separated web origins that the API allows (CORS), for example the deployed site and local dev servers.
ALLOWED_ORIGIN=http://localhost:3000
DB_PATH=data/digigpu.db
SNAPSHOT_DIR=data/snapshots
VAST_API_KEY=
USE_VAST_FIXTURE=0
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_WAREHOUSE_ID=
USE_DATABRICKS_FIXTURE=0
SOLANA_RPC_URL=https://api.devnet.solana.com
